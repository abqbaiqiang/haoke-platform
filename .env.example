APP_ENV=development
APP_TIMEZONE=Asia/Shanghai
APP_BASE_URL=http://localhost:8080
# 局域网访问时允许的额外来源（逗号分隔，与前端访问地址一致）
APP_ALLOWED_ORIGINS=
API_BASE_URL=http://localhost:8080/api
INTERNAL_API_URL=http://127.0.0.1:8000
POSTGRES_DB=songmao_platform
POSTGRES_USER=songmao
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_URL=postgresql+psycopg://songmao:CHANGE_ME_DB_PASSWORD@postgres:5432/songmao_platform
APP_SECRET_KEY=CHANGE_ME_WITH_LONG_RANDOM_VALUE
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
# Demo accounts require explicit seed-demo and are forbidden in production.
DEMO_PASSWORD=CHANGE_ME_DEMO_PASSWORD
TEST_DB_PASSWORD=CHANGE_ME_TEST_DB_PASSWORD
SESSION_HOURS=8
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900
DATA_ROOT=./app-data
UPLOAD_ROOT=/app-data/uploads
IMPORT_MAX_BYTES=12582912
BACKUP_ROOT=/app-data/backups
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
HTTPS_BIND=127.0.0.1
HTTPS_PORT=8443
SITE_ADDRESS=:80
# 构建镜像时的包管理源；在国内服务器/NAS 上可改为镜像源加速构建：
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# NPM_REGISTRY=https://registry.npmmirror.com
# 腾讯位置服务（客户位置地图功能；https://lbs.qq.com 申请）：
# TENCENT_MAP_WEB_KEY：浏览器端地图 JS SDK 用，须在控制台配置域名白名单（含正式域名与局域网调试地址）
# SERVER_KEY=WebServiceAPI Key：仅服务端地址解析代理使用，绝不返回浏览器，须配置服务器 IP 白名单
# 两者留空时地图功能自动降级（界面提示地图未配置，CRM 其他功能不受影响）
TENCENT_MAP_WEB_KEY=
TENCENT_MAP_SERVER_KEY=
# Reserved only. No AI or Jingdouyun API implementation in M0/M1.
AI_ENABLED=false
AI_PROVIDER=openai_compatible
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
JINGDOUYUN_API_ENABLED=false
JINGDOUYUN_BASE_URL=
JINGDOUYUN_APP_KEY=
JINGDOUYUN_APP_SECRET=
JINGDOUYUN_TENANT_ID=
