APP_ENV=development
APP_TIMEZONE=Asia/Shanghai
APP_BASE_URL=http://localhost:8080
# 局域网访问时允许的额外来源（逗号分隔，与前端访问地址一致）
APP_ALLOWED_ORIGINS=
API_BASE_URL=http://localhost:8080/api
INTERNAL_API_URL=http://127.0.0.1:8000
POSTGRES_DB=songmao_platform
POSTGRES_USER=songmao
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_URL=postgresql+psycopg://songmao:CHANGE_ME_DB_PASSWORD@postgres:5432/songmao_platform
APP_SECRET_KEY=CHANGE_ME_WITH_LONG_RANDOM_VALUE
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
# Demo accounts require explicit seed-demo and are forbidden in production.
DEMO_PASSWORD=CHANGE_ME_DEMO_PASSWORD
TEST_DB_PASSWORD=CHANGE_ME_TEST_DB_PASSWORD
SESSION_HOURS=8
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900
DATA_ROOT=./app-data
UPLOAD_ROOT=/app-data/uploads
IMPORT_MAX_BYTES=12582912
BACKUP_ROOT=/app-data/backups
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
HTTPS_BIND=127.0.0.1
HTTPS_PORT=8443
SITE_ADDRESS=:80
# Reserved only. No AI or Jingdouyun API implementation in M0/M1.
AI_ENABLED=false
AI_PROVIDER=openai_compatible
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
JINGDOUYUN_API_ENABLED=false
JINGDOUYUN_BASE_URL=
JINGDOUYUN_APP_KEY=
JINGDOUYUN_APP_SECRET=
JINGDOUYUN_TENANT_ID=
